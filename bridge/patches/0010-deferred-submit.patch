+#[cfg(feature = "unixnu-deferred-submit")]
+#[test]
+fn enqueue_during_blocked_pass_is_drained_in_order() {
+    let inbox = Arc::new(Log::new(Vec::new()));
+    let signal = Arc::new(Condvar::new());
+    let (entered, in_pass) = mpsc::channel();
+    let (release, released) = mpsc::channel::<()>();
+    inbox.enqueue(0);
+    let worker = {
+        let inbox = Arc::clone(&inbox);
+        thread::spawn(move || {
+            inbox.pass(|state, commits| {
+                take_in(state, commits);
+                if state == &[0] {
+                    entered.send(()).unwrap();
+                    released.recv_timeout(WAIT).unwrap();
+                }
+                true
+            });
+        })
+    };
+    in_pass.recv_timeout(WAIT).unwrap();
+    for i in 1..=100 {
+        inbox.enqueue(i);
+        if inbox.wake(|_| {}) {
+            signal.notify_all();
+        }
+    }
+    release.send(()).unwrap();
+    worker.join().unwrap();
+    assert_eq!(*lock(inbox.state()), (0..=100).collect::<Vec<_>>());
+    assert!(!inbox.holds_commits());
+}
+
+#[cfg(feature = "unixnu-deferred-submit")]
+#[test]
+fn enqueue_wakes_sleeping_worker_at_wait_boundary() {
+    let inbox = Arc::new(Log::new(Vec::new()));
+    let signal = Arc::new(Condvar::new());
+    let (ready, waiting) = mpsc::channel();
+    let (done, completed) = mpsc::channel();
+    let worker = {
+        let inbox = Arc::clone(&inbox);
+        let signal = Arc::clone(&signal);
+        thread::spawn(move || {
+            let mut state = lock(inbox.state());
+            ready.send(()).unwrap();
+            while !inbox.holds_commits() {
+                let result = signal.wait_timeout(state, WAIT).unwrap();
+                assert!(!result.1.timed_out(), "worker notification lost");
+                state = result.0;
+            }
+            drop(state);
+            inbox.pass(|state, commits| {
+                take_in(state, commits);
+                true
+            });
+            done.send(()).unwrap();
+        })
+    };
+    waiting.recv_timeout(WAIT).unwrap();
+    inbox.enqueue(41);
+    if inbox.wake(|_| {}) {
+        signal.notify_all();
+    }
+    completed
+        .recv_timeout(WAIT)
+        .expect("sleeping worker did not wake");
+    worker.join().unwrap();
+    assert_eq!(*lock(inbox.state()), vec![41]);
+}
