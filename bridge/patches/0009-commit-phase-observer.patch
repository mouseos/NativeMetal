+/// Optional bounded observer of synchronous commit phases.
+#[cfg(feature = "unixnu-commit-trace")]
+pub mod unixnu_commit_trace {
+    use std::cell::Cell;
+
+    /// Monotonic clock. It must not block, lock, panic, reenter, or call the runtime.
+    pub type Clock = extern "C" fn() -> u64;
+    /// Nonblocking, non-panicking recipient; it must not call the bridge or runtime.
+    pub type Sink = extern "C" fn(u32, u64, u64);
+    #[derive(Clone, Copy)]
+    struct State {
+        id: u64,
+        clock: Clock,
+        sink: Sink,
+        rows: [(u32, u64); 8],
+        len: usize,
+        overflow: bool,
+    }
+    thread_local! { static ACTIVE: Cell<Option<State>> = const { Cell::new(None) }; }
+    thread_local! { static DRAINING: Cell<bool> = const { Cell::new(false) }; }
+
+    /// Restores the prior scope and drains the bounded records on scope exit.
+    struct Scope(Option<State>, std::marker::PhantomData<std::rc::Rc<()>>);
+    impl Scope {
+        fn begin(id: u64, clock: Clock, sink: Sink) -> Self {
+            let previous = ACTIVE.with(|slot| slot.replace(Some(State {
+                id, clock, sink, rows: [(0, 0); 8], len: 0, overflow: false,
+            })));
+            Self(previous, std::marker::PhantomData)
+        }
+    }
+    impl Drop for Scope {
+        fn drop(&mut self) {
+            // The concrete sink is non-reentrant; suppress the enclosing scope
+            // during draining so sink activity is not attributed to it.
+            let current = ACTIVE.with(|slot| slot.replace(None));
+            DRAINING.with(|flag| flag.set(true));
+            if let Some(state) = current {
+                for &(kind, tick) in &state.rows[..state.len] {
+                    (state.sink)(kind, state.id, tick);
+                }
+                if state.overflow { (state.sink)(59, state.id, (state.clock)()); }
+            }
+            DRAINING.with(|flag| flag.set(false));
+            ACTIVE.with(|slot| slot.set(self.0));
+        }
+    }
+    /// Capture one synchronous call. The clock and sink must satisfy their contracts;
+    /// nested calls are isolated and the scope is restored on unwind.
+    pub fn capture<T>(id: u64, clock: Clock, sink: Sink, call: impl FnOnce() -> T) -> T {
+        if DRAINING.with(|flag| flag.get()) { return call(); }
+        let _scope = Scope::begin(id, clock, sink);
+        call()
+    }
+    pub(super) fn record(kind: u32) {
+        ACTIVE.with(|slot| {
+            if let Some(mut state) = slot.get() {
+                if state.len < state.rows.len() {
+                    state.rows[state.len] = (kind, (state.clock)());
+                    state.len += 1;
+                } else {
+                    state.overflow = true;
+                }
+                slot.set(Some(state));
+            }
+        });
+    }
+}
