diff --git a/crates/metal2vulkan-runtime/src/encoder_open_trace.rs b/crates/metal2vulkan-runtime/src/encoder_open_trace.rs
new file mode 100644
index 00000000..af0df2bf
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/encoder_open_trace.rs
@@ -0,0 +1,28 @@
+//! Per-thread, opt-in encoder-open boundary callback. No clock or allocation here.
+use std::cell::Cell;
+use std::ffi::c_void;
+
+/// Called for a boundary on the encoder-opening thread.
+pub type EncoderOpenCallback = unsafe extern "C" fn(*mut c_void, u32);
+thread_local! {
+    static CALLBACK: Cell<Option<(EncoderOpenCallback, *mut c_void)>> = const { Cell::new(None) };
+}
+
+/// Installs a callback on the current thread. Clear it before its context expires.
+///
+/// # Safety
+/// The context and callback must remain valid on this thread until cleared;
+/// the callback must not unwind or re-enter encoder creation.
+pub unsafe fn set_encoder_open_callback(callback: Option<EncoderOpenCallback>, context: *mut c_void) {
+    let _ = CALLBACK.try_with(|slot| slot.set(callback.map(|f| (f, context))));
+}
+
+#[inline]
+pub(crate) fn mark(event: u32) {
+    let _ = CALLBACK.try_with(|slot| {
+        if let Some((callback, context)) = slot.get() {
+            // SAFETY: the installer guarantees callback and context remain live until cleared.
+            unsafe { callback(context, event) };
+        }
+    });
+}
