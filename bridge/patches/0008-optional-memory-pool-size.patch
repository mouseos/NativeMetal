 /// The size of a pooled block, at most the device's `maxMemoryAllocationSize`.
 pub(super) const BLOCK_BYTES: u64 = 64 << 20;
 
+// Optional pool sizing for memory-constrained devices. Unset/invalid keeps the
+// upstream 64 MiB policy; allocation limits and dedicated-resource rules remain.
+fn configured_block_bytes(value: Option<&str>) -> u64 {
+    match value.and_then(|s| s.parse::<u64>().ok()) {
+        Some(mib @ (4 | 8 | 16 | 32 | 64)) => mib << 20,
+        _ => BLOCK_BYTES,
+    }
+}
